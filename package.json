{
  "name": "megatoolsx-com",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/audit-indexability.mjs && node scripts/audit-crawl-efficiency.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/generate-sitemap.mjs --dist",
    "lint": "oxlint",
    "preview": "vite preview",
    "seo:monitor": "node scripts/seo-monitor.mjs",
    "seo:http": "node scripts/seo-monitor.mjs --http",
    "seo:audit": "node scripts/audit-indexability.mjs && node scripts/audit-crawl-efficiency.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "seo:content": "node scripts/audit-seo-content.mjs",
    "seo:gsc": "node scripts/seo-gsc-monitor.mjs",
    "seo:gsc:health": "node scripts/seo-gsc-monitor.mjs --dry-run",
    "seo:audit:gsc": "node scripts/audit-gsc-data.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-pdf": "^6.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.21",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
