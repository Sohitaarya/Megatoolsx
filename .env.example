# ─────────────────────────────────────────────────────────────
# MegaToolsX — production environment template
# COPY to .env (server secrets) — NEVER commit real values.
# Google credentials must NEVER use a VITE_ prefix.
# ─────────────────────────────────────────────────────────────

# SEO monitoring (server-side)
SEO_MONITORING_ENABLED=true
SEO_ADMIN_TOKEN=
SEO_OPPORTUNITY_MIN_IMPRESSIONS=100
SEO_LOW_CTR_THRESHOLD=0.03
SEO_MAX_GSC_PAGES=20
SEO_MAX_GSC_ROWS=100000
SEO_SNAPSHOT_KV=
SEO_ALLOWED_ORIGIN=
SEO_MONITOR_CRON_ENABLED=true

# Google Search Console (server-only secrets)
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=
GOOGLE_ACCESS_TOKEN=
SEO_GSC_PROPERTY=https://megatoolsx.com/

# History / durable storage
SEO_HISTORY_PROVIDER=memory          # memory | kv | d1
SEO_HISTORY_RETENTION_DAYS=90

# Cloudflare (optional)
CLOUDFLARE_ANALYTICS_ENABLED=false

# RUM (client-side, non-secret — build-time)
VITE_RUM_ENABLED=false
VITE_RUM_SAMPLE_RATE=0.1
